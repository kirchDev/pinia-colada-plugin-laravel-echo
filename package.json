{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@kirchdev/pinia-colada-plugin-laravel-echo",
  "version": "0.0.0",
  "description": "Pinia Colada plugin that keeps a query's cache current from Laravel Echo events — and invalidates it when the websocket drops and comes back.",
  "keywords": [
    "echo",
    "kirchdev",
    "laravel",
    "pinia-colada",
    "pinia-colada-plugin",
    "realtime",
    "reverb",
    "vue",
    "websockets"
  ],
  "homepage": "https://github.com/kirchDev/pinia-colada-plugin-laravel-echo#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/pinia-colada-plugin-laravel-echo/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/pinia-colada-plugin-laravel-echo.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test && pnpm check:policy",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.ts",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@pinia/colada": "^1.4.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "laravel-echo": "^2.4.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "pinia": "^3.0.3",
    "taze": "^21.1.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "@pinia/colada": "^1.4.0",
    "laravel-echo": "^2.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
